# 아래 두 키의 = 뒤에 값을 입력하세요.
OPENAI_API_KEY=
LANGSMITH_API_KEY=

# 새로 만드는 게임에 적용할 모델 설정
GAME_PROVIDER=openai
GAME_MODEL=gpt-4.1-mini
GAME_MAX_CALLS=300

# 추적에는 개인 역할과 게임 발언이 포함될 수 있습니다.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=night-testimony

# 외부 모델 프롬프트 UTF-8 바이트 상한 (토큰 수 아님)
GAME_MAX_PROMPT_BYTES=262144

# 실측상 캐시 교체 비용이 더 커 기본 비활성화 (비교 실험용)
GAME_MEMORY_TOKEN_CACHE=false

# 서로 다른 방의 AI 판단 동시 실행 수 (1~8, 기본 2)
GAME_AI_CONCURRENCY=2

# 슬롯 획득 후 AI 판단의 협력적 시간 예산 (초)
GAME_DECISION_SECONDS=120
# 같은 제공자 내 모델 라우팅. 비우면 기존 GAME_MODEL 사용
GAME_FAST_MODEL=
GAME_QUALITY_MODEL=

# 모델에 보낼 observation JSON 바이트 예산. 전체 프롬프트/토큰 한도와 별개.
# 필수 근거는 유지하고 낮은 검색 순위 기록부터 제외. 필수 근거만으로 초과하면 일시 중지.
GAME_CONTEXT_BYTES=32768
# 목격 등 의심 근거의 경과 일차 허용치. 2이면 당일~2일 후. 확정 사실은 만료하지 않음.
GAME_SUSPICION_DAYS=2
