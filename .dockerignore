# Allowlist: secrets, local DBs, venvs and host node_modules never enter the context.
**
!Dockerfile
!docker/
!docker/mlflow.Dockerfile
!requirements-lock.txt
!requirements-mlflow-lock.txt
!game/
!game/**
game/**/__pycache__/
game/**/*.pyc
!frontend/
!frontend/index.html
!frontend/ops.html
!frontend/package.json
!frontend/package-lock.json
!frontend/assets/
!frontend/assets/**
!reports/
!reports/claim-guard-reviewed-v2.json
!tools/
!tools/container_entrypoint.py
!tools/log_evaluation_mlflow.py
!tests/
!tests/**
tests/**/__pycache__/
tests/**/*.pyc

# Defense in depth for files placed inside an allowed directory.
**/.env
**/.env.*
**/*.db
**/*.db-shm
**/*.db-wal
**/*.pem
**/*.key
